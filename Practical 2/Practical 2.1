#include <iostream>
using namespace std;

int recursiveSearch(int arr[], int n, int key, int i)
{
    if (i == n)
        return -1;

    if (arr[i] == key)
        return i;

    return recursiveSearch(arr, n, key, i + 1);
}

int main()
{
    int n, temp;

    cout << "Enter size: ";
    cin >> n;

    int arr[n];

    cout << "Enter car plates number: ";
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    cout << "Enter car plates number to search: ";
    cin >> temp;

    int pos = -1;
    for (int i = 0; i < n; i++)
    {
        if (arr[i] == temp)
        {
            pos = i;
            break;
        }
    }

    if (pos != -1)
        cout << " Found at position " << pos + 1 << endl;
    else
        cout << "Not Found" << endl;

    pos = recursiveSearch(arr, n, temp, 0);

    if (pos != -1)
        cout << " Found at position " << pos + 1 << endl;
    else
        cout << " Not Found" << endl;

    return 0;
}
